generator client {
  provider = "prisma-client-js"
  // Ship both engine variants: the Docker build stage runs without OpenSSL
  // (generates 1.1.x) while the slim runtime has OpenSSL 3 installed, so the
  // client must carry both or production queries fail to locate an engine.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
  // Post-review operational states set from recorded field actions:
  // FIELD_CHECKED — a field visit happened but found nothing / could not access
  // FIELD_CONFIRMED — a field visit confirmed the sighting (distinct from desk VERIFIED)
  // ACTION_TAKEN — control action carried out
  // MONITORING — follow-up visit required
  // REASSESSMENT — new evidence after an earlier action, needs re-evaluation
  FIELD_CHECKED
  FIELD_CONFIRMED
  ACTION_TAKEN
  MONITORING
  REASSESSMENT
}

/// Result of one field visit recorded by an authorized officer. Never inferred
/// from anything else — officers choose exactly one truthful outcome.
/// Maps to a report status via FIELD_OUTCOME_STATUS_MAP (src/server/field-outcomes.ts).
enum FieldOutcome {
  FOUND
  NOT_FOUND
  MISIDENTIFIED
  CONTROLLED
  FOLLOW_UP_REQUIRED
  ACCESS_DENIED
}

/// Lifecycle of one ingestion pipeline execution (sources → intelligence).
enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// What started an ingestion run — a developer command or the Railway cron.
enum IngestionTrigger {
  MANUAL
  SCHEDULED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// Processing lifecycle of an ingested external observation through the
/// intelligence worker (RAW → PROCESSED, or FAILED with the error preserved).
enum ObservationProcessingStatus {
  RAW
  PROCESSED
  FAILED
}

/// How precisely a location is known. Derived ONLY from what a source actually
/// states — province-level text never invents an EXACT coordinate.
enum LocationPrecision {
  EXACT
  WATERBODY
  SUBDISTRICT
  DISTRICT
  PROVINCE
  UNKNOWN
}

/// Three-state relationship between the observation point and the photo location.
/// Historical records never captured this — they are UNKNOWN, not SAME/DIFFERENT.
enum PhotoLocationRelation {
  SAME
  DIFFERENT
  UNKNOWN
}

/// Three-way relevance verdict from the explainable pipeline. Thresholds are
/// documented in docs/intelligence.md; verdicts never imply a confirmed
/// biological occurrence.
enum RelevanceVerdict {
  RELEVANT
  IRRELEVANT
  UNCERTAIN
}

/// A pre-field operational triage decision — deliberately separate from
/// FieldOutcome (which records what happened DURING a field visit). Recording
/// a decision never fabricates a field visit and never changes ReportStatus;
/// it only annotates the report with the officer's current call so the next
/// officer sees it, backed by durable audit history (ReportDecision).
enum OperationalDecisionType {
  DISPATCH // ส่งทีมลงพื้นที่
  MONITOR // เฝ้าระวังก่อน
  DEFER // ยังไม่ดำเนินการ
}

/// Provenance of the uploaded image — how it entered the system.
/// Never inferred; only explicitly declared or detected.
enum ImageProvenance {
  CAPTURED_IN_FIHDAR      // Taken directly in the FihDar app (camera capture)
  ORIGINAL_UPLOAD         // User uploaded an original file from their device
  DERIVED_OR_SCREENSHOT   // Detected as screenshot or derived image
  FORWARDED_OR_EXTERNAL   // Forwarded from LINE/Facebook/etc. or external source
  UNKNOWN                 // Provenance cannot be determined (historical/default)
}

model UserProfile {
  id           String           @id @default(uuid()) @db.Uuid
  clerkUserId  String           @unique
  displayName  String
  email        String
  phone        String?
  organization String?
  province     String?
  avatarUrl    String?
  reports      SightingReport[]
  fieldActions ReportFieldAction[]
  decisions    ReportDecision[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SightingReport {
  id                  String       @id @default(uuid()) @db.Uuid
  publicReference     String       @unique
  reporterId          String       @db.Uuid
  reporter            UserProfile  @relation(fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  latitude            Float
  longitude           Float
  province            String
  district            String?
  subdistrict         String?
  locationDescription String?
  observedAt          DateTime
  quantityRange       String
  note                String?
  imagePath           String
  status              ReportStatus   @default(PENDING)
  riskLevel           RiskLevel?
  verifiedAt          DateTime?
  // How precisely the observation point is known — declared by the reporter
  // (EXACT / WATERBODY / … / UNKNOWN), never inferred from the coordinates.
  // Default UNKNOWN for data integrity: historical records never declared precision.
  locationPrecision   LocationPrecision @default(UNKNOWN)
  // Three-state relationship between the observation point and the photo location.
  // Historical records never captured this — they are UNKNOWN, not SAME/DIFFERENT.
  photoLocationRelation PhotoLocationRelation @default(UNKNOWN)
  // Legacy boolean (kept for migration safety). New code uses photoLocationRelation.
  // True = photo taken elsewhere (DIFFERENT), False = photo taken at observation point (SAME).
  // Historical records: this defaulted to false but truth is UNKNOWN.
  photoTakenElsewhere Boolean       @default(false)
  // EXIF/metadata extracted from the uploaded image (GPS, timestamp, dimensions, etc.).
  // Stored as supporting evidence ONLY — never treated as ground truth for location/time.
  imageMetadata       Json?
  // Provenance of the uploaded image — how it entered the system.
  // CAPTURED_IN_FIHDAR = taken in-app; ORIGINAL_UPLOAD = user selected file;
  // DERIVED_OR_SCREENSHOT = screenshot detected; FORWARDED_OR_EXTERNAL = from LINE/FB/etc.
  imageProvenance     ImageProvenance @default(UNKNOWN)
  // Populated by the automatic reassessment pipeline (`scripts/intel/reassess.mjs`)
  // when a newly ingested external observation matches an acted-on report. JSON
  // shape: { observationId, matchedAt, matchedProvince, matchedDistrict }.
  reassessmentTrigger Json?
  fieldActions        ReportFieldAction[]
  // Denormalized pointer to the latest operational decision (DISPATCH/MONITOR/
  // DEFER), for cheap list-view display. Full audit history lives in
  // ReportDecision — this field is never the source of truth, only a cache.
  operationalDecision OperationalDecisionType?
  decisions           ReportDecision[]
  // Provenance: system-validation records (created by `npm run db:seed`).
  // Genuine citizen reports always carry isSeedData=false — cleanup deletes
  // only rows where this is true, so real reports can never be touched.
  isSeedData          Boolean       @default(false)
  seedBatchId         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([province])
  @@index([observedAt])
  @@index([createdAt])
  @@index([isSeedData, seedBatchId])
}

/// One field visit recorded by an authorized officer against a citizen report.
/// The report's status is derived from the latest action's outcome; the action
/// rows are the immutable history the citizen can read back.
model ReportFieldAction {
  id               String        @id @default(uuid()) @db.Uuid
  reportId         String        @db.Uuid
  report           SightingReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  officerProfileId String        @db.Uuid
  officer          UserProfile   @relation(fields: [officerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outcome          FieldOutcome
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([reportId])
  @@index([officerProfileId])
}

/// One PRE-FIELD operational triage call by an officer — DISPATCH / MONITOR /
/// DEFER. Distinct from ReportFieldAction (which is POST-visit). Recording a
/// decision never creates a ReportFieldAction and never changes ReportStatus;
/// it only updates SightingReport.operationalDecision (the current-value
/// cache). Rows are never deleted or updated — this is the durable audit
/// trail (actor, decision, reason, previous/new decision, timestamp).
model ReportDecision {
  id               String                   @id @default(uuid()) @db.Uuid
  reportId         String                   @db.Uuid
  report           SightingReport           @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  officerProfileId String                   @db.Uuid
  officer          UserProfile              @relation(fields: [officerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decision         OperationalDecisionType
  reason           String?
  previousDecision OperationalDecisionType?
  createdAt        DateTime                 @default(now())

  @@index([reportId])
  @@index([officerProfileId])
}

/// External information ingested from a public source (government open data,
/// news feeds). Distinct from citizen SightingReports: no reporter, no image,
/// and coordinates are stored only when the source actually provides them.
model ExternalObservation {
  id               String    @id @default(uuid()) @db.Uuid
  sourceName       String
  sourceExternalId String
  sourceUrl        String
  title            String
  description      String?
  province         String?
  district         String?
  subdistrict      String?
  latitude         Float?
  longitude        Float?
  publishedAt      DateTime?
  scrapedAt        DateTime  @default(now())
  status           String    @default("NEW")
  rawMetadata      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceName, sourceExternalId])
  @@index([sourceName])
  @@index([status])

  // --- Intelligence enrichment (populated by `npm run db:intel`) -------------
  // All fields are additive; the raw source text (title/description) is never
  // overwritten. RAW records stay fully usable if processing fails.
  processingStatus ObservationProcessingStatus @default(RAW)
  processedAt       DateTime?
  processingError   String?

  // Normalized location from deterministic extraction + fuzzy matching.
  locationPrecision    LocationPrecision @default(UNKNOWN)
  normalizedProvince   String?
  normalizedDistrict   String?
  normalizedSubdistrict String?
  normalizedWaterbody  String?

  // Explainable relevance: component scores live in `evidence`; the verdict is
  // the pipeline's classification, never an automatic biological confirmation.
  relevanceVerdict RelevanceVerdict?
  relevanceKind    String?
  evidence         Json?

  // Near-duplicate handling: never deletes — points at the canonical row.
  duplicateOfId String?              @db.Uuid
  duplicateOf   ExternalObservation? @relation("ObservationDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  duplicates    ExternalObservation[] @relation("ObservationDuplicates")

  // Derived spatial association — kept strictly separate from the source
  // latitude/longitude above (which are always source-provided, never invented).
  derivedNearestWaterway  String?
  derivedDistanceMeters   Float?
  derivedWaterwaySource   String?

  eventCandidates EventCandidateObservation[]

  @@index([processingStatus])
  @@index([locationPrecision])
  @@index([relevanceVerdict])
  @@index([duplicateOfId])
  @@index([normalizedProvince])
}

/// Experimental grouping of several observations that may reference the same
/// real-world event. Status stays EXPERIMENTAL — grouping never verifies.
model EventCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  status           String   @default("EXPERIMENTAL")
  kind             String?
  province         String?
  eventDate        DateTime?
  locationPrecision LocationPrecision?
  evidence         Json?
  observations     EventCandidateObservation[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EventCandidateObservation {
  candidateId   String   @db.Uuid
  observationId String   @db.Uuid
  role          String   @default("supporting")
  addedBy       String   @default("intel-worker")
  createdAt     DateTime @default(now())

  candidate    EventCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  observation  ExternalObservation @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([candidateId, observationId])
  @@index([observationId])
}

/// Registry metadata for every trusted external source. The EXECUTABLE fetch
/// behavior lives only in the allowlisted code registry (scripts/ingestion),
/// never in these rows — so a compromised row can never make the worker fetch
/// an arbitrary URL (no SSRF surface). This table carries display/health
/// metadata and is kept in sync with the code registry on every ingestion run.
model DataSource {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  label            String
  category         String
  transport        String // RSS | CKAN | JSON API
  authorityType    String // news | government | citizen-science
  trustTier        String   @default("trusted")
  enabled          Boolean  @default(true)
  displayOrder     Int      @default(0)
  description      String?
  homepage         String?
  coverageMetadata Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled])
  @@index([category])
  @@index([transport])
}

/// One execution of the refresh pipeline: source ingestion → intelligence
/// processing. Created RUNNING by scripts/refresh-intelligence.mjs and
/// finalized with a deterministic status; the JSON columns hold sanitized
/// operational summaries (never secrets or stack traces intended for clients).
model IngestionRun {
  id             String             @id @default(uuid()) @db.Uuid
  trigger        IngestionTrigger   @default(MANUAL)
  status         IngestionRunStatus @default(RUNNING)

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  createdCount   Int @default(0)
  skippedCount   Int @default(0)
  processedCount Int @default(0)
  failedCount    Int @default(0)

  sourceResults   Json?
  pipelineSummary Json?
  errorSummary    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startedAt])
  @@index([status])
}
