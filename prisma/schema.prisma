generator client {
  provider = "prisma-client-js"
  // Ship both engine variants: the Docker build stage runs without OpenSSL
  // (generates 1.1.x) while the slim runtime has OpenSSL 3 installed, so the
  // client must carry both or production queries fail to locate an engine.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// Processing lifecycle of an ingested external observation through the
/// intelligence worker (RAW → PROCESSED, or FAILED with the error preserved).
enum ObservationProcessingStatus {
  RAW
  PROCESSED
  FAILED
}

/// How precisely a location is known. Derived ONLY from what a source actually
/// states — province-level text never invents an EXACT coordinate.
enum LocationPrecision {
  EXACT
  WATERBODY
  SUBDISTRICT
  DISTRICT
  PROVINCE
  UNKNOWN
}

/// Three-way relevance verdict from the explainable pipeline. Thresholds are
/// documented in docs/intelligence.md; verdicts never imply a confirmed
/// biological occurrence.
enum RelevanceVerdict {
  RELEVANT
  IRRELEVANT
  UNCERTAIN
}

model UserProfile {
  id           String           @id @default(uuid()) @db.Uuid
  clerkUserId  String           @unique
  displayName  String
  email        String
  phone        String?
  organization String?
  province     String?
  avatarUrl    String?
  reports      SightingReport[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SightingReport {
  id                  String       @id @default(uuid()) @db.Uuid
  publicReference     String       @unique
  reporterId          String       @db.Uuid
  reporter            UserProfile  @relation(fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  latitude            Float
  longitude           Float
  province            String
  district            String?
  subdistrict         String?
  locationDescription String?
  observedAt          DateTime
  quantityRange       String
  note                String?
  imagePath           String
  status              ReportStatus @default(PENDING)
  riskLevel           RiskLevel?
  verifiedAt          DateTime?
  // Provenance: system-validation records (created by `npm run db:seed`).
  // Genuine citizen reports always carry isSeedData=false — cleanup deletes
  // only rows where this is true, so real reports can never be touched.
  isSeedData          Boolean      @default(false)
  seedBatchId         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([province])
  @@index([observedAt])
  @@index([createdAt])
  @@index([isSeedData, seedBatchId])
}

/// External information ingested from a public source (government open data,
/// news feeds). Distinct from citizen SightingReports: no reporter, no image,
/// and coordinates are stored only when the source actually provides them.
model ExternalObservation {
  id               String    @id @default(uuid()) @db.Uuid
  sourceName       String
  sourceExternalId String
  sourceUrl        String
  title            String
  description      String?
  province         String?
  district         String?
  subdistrict      String?
  latitude         Float?
  longitude        Float?
  publishedAt      DateTime?
  scrapedAt        DateTime  @default(now())
  status           String    @default("NEW")
  rawMetadata      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceName, sourceExternalId])
  @@index([sourceName])
  @@index([status])

  // --- Intelligence enrichment (populated by `npm run db:intel`) -------------
  // All fields are additive; the raw source text (title/description) is never
  // overwritten. RAW records stay fully usable if processing fails.
  processingStatus ObservationProcessingStatus @default(RAW)
  processedAt       DateTime?
  processingError   String?

  // Normalized location from deterministic extraction + fuzzy matching.
  locationPrecision    LocationPrecision @default(UNKNOWN)
  normalizedProvince   String?
  normalizedDistrict   String?
  normalizedSubdistrict String?
  normalizedWaterbody  String?

  // Explainable relevance: component scores live in `evidence`; the verdict is
  // the pipeline's classification, never an automatic biological confirmation.
  relevanceVerdict RelevanceVerdict?
  relevanceKind    String?
  evidence         Json?

  // Near-duplicate handling: never deletes — points at the canonical row.
  duplicateOfId String?              @db.Uuid
  duplicateOf   ExternalObservation? @relation("ObservationDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  duplicates    ExternalObservation[] @relation("ObservationDuplicates")

  // Derived spatial association — kept strictly separate from the source
  // latitude/longitude above (which are always source-provided, never invented).
  derivedNearestWaterway  String?
  derivedDistanceMeters   Float?
  derivedWaterwaySource   String?

  eventCandidates EventCandidateObservation[]

  @@index([processingStatus])
  @@index([locationPrecision])
  @@index([relevanceVerdict])
  @@index([duplicateOfId])
  @@index([normalizedProvince])
}

/// Experimental grouping of several observations that may reference the same
/// real-world event. Status stays EXPERIMENTAL — grouping never verifies.
model EventCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  status           String   @default("EXPERIMENTAL")
  kind             String?
  province         String?
  eventDate        DateTime?
  locationPrecision LocationPrecision?
  evidence         Json?
  observations     EventCandidateObservation[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EventCandidateObservation {
  candidateId   String   @db.Uuid
  observationId String   @db.Uuid
  role          String   @default("supporting")
  addedBy       String   @default("intel-worker")
  createdAt     DateTime @default(now())

  candidate    EventCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  observation  ExternalObservation @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([candidateId, observationId])
  @@index([observationId])
}
