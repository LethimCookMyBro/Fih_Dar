# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.data/

# misc
.DS_Store
Thumbs.db
*.pem
*.sw[a-p]

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
.env*.local

# vercel
.vercel

# railway CLI link metadata (project/service IDs — not source)
.railway/

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/

# freebuff worktree metadata
.freebuff/

# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin

# NOTE: public/maplibre/* (maplibre-gl worker modules) is intentionally NOT
# ignored — the worker is served as a static asset and must ship in the Docker
# build context, which respects .gitignore. Kept in sync by the postinstall
# script (scripts/copy-maplibre-worker.mjs); re-commit when maplibre bumps.
