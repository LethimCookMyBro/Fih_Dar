{
  "name": "fihdar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "prepare": "husky",
    "postinstall": "prisma generate && node scripts/copy-maplibre-worker.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:clear-seed": "node --env-file=.env scripts/clear-seed.mjs",
    "db:ingest": "node --env-file=.env scripts/ingest.mjs",
    "ingest:test": "node scripts/ingestion/self-test.mjs",
    "db:intel": "node --env-file=.env scripts/intel/process.mjs",
    "intel:backfill-priority": "node --env-file=.env scripts/intel/backfill-priority.mjs",
    "db:refresh": "node --env-file=.env scripts/refresh-intelligence.mjs",
    "db:refresh:prod": "node scripts/refresh-intelligence.mjs",
    "test:e2e": "playwright test",
    "intel:test": "node scripts/intel/self-test.mjs",
    "masterpass:test": "node --experimental-strip-types scripts/master-pass/self-test.mjs",
    "masterpass:officer-test": "node --env-file=.env --conditions=react-server --experimental-transform-types --import ./scripts/master-pass/register-alias-loader.mjs scripts/master-pass/officer-workflow.test.mjs",
    "masterpass:exif-test": "node --conditions=react-server --experimental-transform-types --import ./scripts/master-pass/register-alias-loader.mjs scripts/master-pass/exif-hardening.test.mjs",
    "intel:benchmark": "node --env-file=.env scripts/intel/benchmark.mjs",
    "intel:export-review": "node --env-file=.env scripts/intel/export-review.mjs",
    "geo:download": "node scripts/geo/download-thailand-extent.mjs",
    "intel:export-review-csv": "node --env-file=.env scripts/intel/export-review-csv.mjs",
    "waterways:download": "node scripts/intel/waterways/download.mjs",
    "waterways:analyze": "node --env-file=.env scripts/intel/waterways/analyze.mjs",
    "waterways:graph": "node scripts/intel/waterways/graph.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/localizations": "^3.37.8",
    "@clerk/nextjs": "^7.3.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@react-three/rapier": "^2.2.0",
    "@sentry/nextjs": "^10.45.0",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "fuzzball": "^2.2.6",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "maplibre-gl": "^6.3.0",
    "meshline": "^3.3.1",
    "minhash": "^0.0.9",
    "motion": "^11.18.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.8.9",
    "postcss": "8.5.25",
    "postprocessing": "^6.39.4",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.4.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sharp": "^0.35.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "thai-address-database": "^0.0.31",
    "three": "^0.185.1",
    "typescript": "5.7.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sort-by": "^1.2.3",
    "@types/uuid": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "polygon-clipping": "^0.15.7",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  }
}
